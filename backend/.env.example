# Project Power-Up Backend Configuration
# Copy this file to .env and update the values

# Database Configuration
# Choose either 'postgresql' or 'sqlite'
DATABASE_TYPE=postgresql

# PostgreSQL Configuration (used when DATABASE_TYPE=postgresql)
POSTGRES_SERVER=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=project_planning
POSTGRES_PORT=5432

# SQLite Configuration (used when DATABASE_TYPE=sqlite)
SQLITE_PATH=./project_powerup.db

# Alternative: Direct database URI (overrides above settings if provided)
# DATABASE_URI=postgresql://user:password@localhost:5432/dbname
# DATABASE_URI=sqlite:///./project_powerup.db

# Vector Database Configuration
CHROMA_PERSIST_DIRECTORY=./chroma_db

# AI Configuration
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-haiku-20240307

# File Upload Configuration
UPLOAD_DIRECTORY=./uploads
